# Port the local API server listens on
PORT=3000

# Base URL the MCP server uses to call the local API
API_BASE_URL=http://localhost:3000

# Calendar dates in start_date/end_date are interpreted in this timezone
REPORTING_TIMEZONE=Asia/Kolkata

# TruBuddy website MySQL (sessions/events/purchases) — read-only.
# Same 5 variable names work for local Laragon dev now and production later.
TRUBUDDY_DB_HOST=127.0.0.1
TRUBUDDY_DB_PORT=3306
TRUBUDDY_DB_DATABASE=menstrupedia
TRUBUDDY_DB_USER=root
TRUBUDDY_DB_PASSWORD=

# Absolute path to trubuddyweb's app/Http/assets/json/allProducts.json
TRUBUDDY_PRODUCT_CATALOG_PATH=
