# Port the local API server listens on
PORT=3000

# Base URL the MCP server uses to call the local API
API_BASE_URL=http://localhost:3000

# Calendar dates in start_date/end_date are interpreted in this timezone
REPORTING_TIMEZONE=Asia/Kolkata

# Preferred production source: TruBuddy Laravel endpoint.
# Example: https://trubuddy.me/meta-ads-mcp/analytics
TRUBUDDY_ANALYTICS_URL=

# Port the remote (Streamable HTTP) MCP server listens on. Separate from PORT
# (the analytics API) so both can run at the same time.
MCP_HTTP_PORT=3001

# Host used only for the SDK's built-in DNS-rebinding protection check.
# Leave as 127.0.0.1 for local runs. Change once this is deployed behind a
# real hostname/HTTPS for remote connector use.
MCP_HTTP_HOST=127.0.0.1
