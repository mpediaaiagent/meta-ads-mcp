# Port the local API server listens on
PORT=3000

# Base URL the MCP server uses to call the local API
API_BASE_URL=http://localhost:3000

# Calendar dates in start_date/end_date are interpreted in this timezone
REPORTING_TIMEZONE=Asia/Kolkata

# Preferred production source: TruBuddy Laravel endpoint.
# Example: https://trubuddy.me/meta-ads-mcp/analytics
TRUBUDDY_ANALYTICS_URL=
TRUBUDDY_ANALYTICS_SECRET=

# TruBuddy website MySQL (sessions/events/purchases) — read-only.
# Same 5 variable names work for local Laragon dev now and production later.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=menstrupedia
DB_USER=root
DB_PASSWORD=

# Optional override for the local product catalog JSON copy
PRODUCT_CATALOG_PATH=src/api/data/allProducts.json
